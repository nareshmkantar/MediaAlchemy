# Copy to .env and fill in your values (never commit .env)
# cp .env.example .env

# --- Production / Render (set in dashboard Environment tab) ---
# RENDER is set automatically on Render; enables production defaults.
# SIA_DEBUG_ENABLED=false   # strongly recommended on Render (avoids RAM/disk growth)
# SIA_JOB_RETENTION_WARN=15   # warn in UI when this many jobs are in memory
# SIA_PRODUCTION=true         # optional: force production defaults locally

# Azure OpenAI (required for azure-* models)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Default model when user_config.json is absent (Render deploy)
SIA_LLM_MODEL=azure-gpt-5.3-chat

# Other LLM providers (optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: force LLM judge on/off (true|false)
# SIA_ENABLE_LLM_JUDGE=false

# Local dev only: enable Debug tab / per-tool CSV snapshots
# SIA_DEBUG_ENABLED=true

# Durable job + HITL persistence (Phase B/C) — survives server restart
# SCHEMA_AGENT_METADATA_DB=runtime/metadata.db
# Or: SCHEMA_AGENT_PERSIST_JOBS=true  (uses runtime/metadata.db by default)
